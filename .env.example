# Copy to .env and fill in. Never commit .env.

# Required: all hosted models go through OpenRouter (Claude, Gemini, DeepSeek, free models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter shows on its dashboard
OPENROUTER_APP_NAME=papertrail
OPENROUTER_APP_URL=https://github.com/Prakhar-Tiwari-1/PAPERTRAIL-From-Paper-to-Podium

# Local model for the fact-check stage (SPEC §7.8)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Optional: raises Semantic Scholar rate limits; works without a key at our volume
SEMANTIC_SCHOLAR_API_KEY=

# Optional: override where the LLM response cache lives
P2D_CACHE_DIR=.cache/llm

# Optional: score with a second judge (DeepSeek reasoning model) and report judge agreement
PAPERTRAIL_SECOND_JUDGE=0
# Optional: name of a WSL distro to run the analyst sandbox under `unshare -rn` (see README "Sandbox")
PAPERTRAIL_WSL_DISTRO=
